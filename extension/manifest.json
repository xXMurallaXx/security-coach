{
  "manifest_version": 3,
  "name": "Security Coach",
  "version": "1.0",
  "description": "Tu entrenador personal de ciberseguridad",

  "permissions": [
    "tabs",
    "notifications",
    "scripting",
    "webRequest"
  ],

  "host_permissions": [
    "http://localhost:8001/*",
    "http://127.0.0.1:8001/*",
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  }
}